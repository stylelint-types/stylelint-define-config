{
  "name": "stylelint-define-config",
  "version": "17.15.0",
  "description": "Provide a defineConfig function for stylelint.config.js files",
  "keywords": [
    "config",
    "configuration",
    "define-config",
    "stylelint",
    "stylelint-config",
    "stylelintconfig",
    "typed",
    "typescript"
  ],
  "homepage": "https://github.com/stylelint-types/stylelint-define-config#readme",
  "bugs": "https://github.com/stylelint-types/stylelint-define-config/issues",
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/stylelint-types/stylelint-define-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint . --type-check --type-aware && oxfmt . --check",
    "format": "oxlint . --type-check --type-aware --fix && oxfmt .",
    "release:publish": "pnpm publish",
    "release:changelog": "conventional-changelog -p angular && oxfmt ./CHANGELOG.md",
    "release": "bumpp package.json --execute=\"pnpm release:changelog\" --commit --all --push --tag"
  },
  "dependencies": {
    "csstype": "^3.2.3"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.14.0",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "stylelint": "^18.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "stylelint": ">=17.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=9",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.18.0"
}
